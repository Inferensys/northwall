# Backend
PORT=4000
DEV_AUTH_BYPASS=true

# Local GitHub token fallback.
# Keep this server-side. Do not expose it with NEXT_PUBLIC_.
GITHUB_TOKEN=
GITHUB_ACCOUNT=

# GitHub provider token encryption.
TOKEN_ENCRYPTION_KEY=

# OpenAI / Azure OpenAI. Backend only.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_DEV_AUTH_BYPASS=true

# Supabase GitHub OAuth.
# Required when DEV_AUTH_BYPASS=false.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
